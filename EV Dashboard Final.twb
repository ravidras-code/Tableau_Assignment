      <aliases enabled='yes' />
      <column caption='Average Electric Range' datatype='real' name='[Calculation_1175129117413376]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([Electric Range])' />
      </column>
      <column caption='Bev Count' datatype='integer' name='[Calculation_1175129130545153]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_1278757739712512] = &quot;Battery Electric Vehicle&quot; THEN 1 ELSE 0 END' />
      </column>
      <column caption='Bev %' datatype='string' default-format='p0.00%' name='[Calculation_1175129132605442]' role='measure' type='nominal'>
        <calculation class='tableau' formula='&quot;% of Total: &quot; + STR(ROUND(SUM(IF [Calculation_1278757739712512] = &quot;Battery Electric Vehicle&quot; THEN 1 ELSE 0 END) &#13;&#10;/ COUNT([Vehicle ID])*100,2))+&quot;%&quot;' />
      </column>
      <column caption='HEV' datatype='integer' name='[Calculation_1175129138634755]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_1278757739712512] = &quot;Hybrid Electric Vehicle&quot; THEN 1 ELSE 0 END' />
      </column>
      <column caption='HEV %' datatype='string' name='[Calculation_1175129139232772]' role='measure' type='nominal'>
        <calculation class='tableau' formula='&quot;% of Total: &quot; + STR(ROUND(SUM(IF [Calculation_1278757739712512] = &quot;Hybrid Electric Vehicle&quot; THEN 1 ELSE 0 END) &#13;&#10;/ COUNT([Vehicle ID])*100,2))+&quot;%&quot;' />
      </column>
      <column caption='Ev Type' datatype='string' name='[Calculation_1278757739712512]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Electric Vehicle Type] = &quot;Battery Electric Vehicle (BEV)&quot; THEN &quot;Battery Electric Vehicle&quot;&#13;&#10;ELSEIF [Electric Vehicle Type] = &quot;Plug-in Hybrid Electric Vehicle (PHEV)&quot; THEN &quot;Hybrid Electric Vehicle&quot;&#13;&#10;ELSE [Electric Vehicle Type]&#13;&#10;END' />
      </column>
      <column caption='Is Vehicle Location Flag' datatype='string' name='[Calculation_1278757741371393]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([Vehicle Location]) OR [Vehicle Location] = &quot;&quot; THEN &quot;Exclude&quot;&#13;&#10;ELSE &quot;Include&quot;&#13;&#10;END' />
      </column>
      <column caption='Electric Range Bin' datatype='string' name='[Calculation_1278757742854146]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Electric Range] &gt;= 0 AND [Electric Range] &lt;= 100 THEN &quot;Low&quot;&#13;&#10;ELSEIF [Electric Range] &gt;= 101 AND [Electric Range] &lt;= 200 THEN &quot;Medium&quot;&#13;&#10;ELSEIF [Electric Range] &gt; 200 THEN &quot;High&quot;&#13;&#10;END' />
      </column>
      <column caption='Latitude_location' datatype='real' name='[Calculation_1278757743616003]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='FLOAT(&#13;&#10;  SPLIT(&#13;&#10;    REPLACE(REPLACE([Vehicle Location], &quot;POINT (&quot;, &quot;&quot;), &quot;)&quot;, &quot;&quot;),&#13;&#10;    &quot; &quot;,&#13;&#10;    1&#13;&#10;  )&#13;&#10;)' />
      </column>
      <column caption='Longitude_location' datatype='real' name='[Calculation_1278757743833092]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='FLOAT(&#13;&#10;  SPLIT(&#13;&#10;    REPLACE(REPLACE([Vehicle Location], &quot;POINT (&quot;, &quot;&quot;), &quot;)&quot;, &quot;&quot;),&#13;&#10;    &quot; &quot;,&#13;&#10;    2&#13;&#10;  )&#13;&#10;)' />
      </column>
      <column caption='Address' datatype='string' name='[Calculation_1278757744336901]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [State] = &quot;WA&quot; THEN&#13;&#10;    [City] + &quot;, Washington, &quot; + STR([Postal Code])&#13;&#10;ELSE&#13;&#10;    [City] + &quot;, &quot; + [State] + &quot;, &quot; + STR([Postal Code])&#13;&#10;END' />
      </column>
      <column caption='Total EV' datatype='integer' name='[Calculation_1278757745950726]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([Electric Vehicle Type])' />
      </column>
